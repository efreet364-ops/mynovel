# Spring profile
SPRING_PROFILES_ACTIVE=prod

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/novel?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=novel
SPRING_DATASOURCE_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# RabbitMQ. Keep disabled for a simple demo deployment.
AMQP_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=/novel
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch. Keep disabled for a simple demo deployment.
ES_ENABLED=false
ES_URIS=http://127.0.0.1:9200

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE=1800
JWT_REFRESH_TOKEN_EXPIRE=604800

# CORS. If Nginx serves frontend and proxies /api on the same domain, this is mostly a fallback.
APP_FILE_SAVE_DIR=/opt/mynovel/tmp
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.com

# AI and search
AI_DASHSCOPE_API_KEY=
SEARCH_API_KEY=
SEARCH_API_URL=https://www.searchapi.io/api/v1/search

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aud
STRIPE_CNY_TO_AUD_RATE=0.21
STRIPE_MIN_AMOUNT_CNY=1
STRIPE_MAX_AMOUNT_CNY=500
STRIPE_SUCCESS_URL=https://your-domain.com/#/user/recharge/result
STRIPE_CANCEL_URL=https://your-domain.com/#/user/recharge/result

# Aliyun OSS. SDK credentials should also be provided in the runtime environment.
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_BUCKET_NAME=your-bucket
ALIYUN_OSS_AGENT_BUCKET_NAME=your-agent-bucket
ALIYUN_OSS_AGENT_URL_EXPIRE_DAYS=7
ALIYUN_OSS_AGENT_PREFIX=agent/pdf/

# Logs
SPRING_AI_LOG_LEVEL=INFO
